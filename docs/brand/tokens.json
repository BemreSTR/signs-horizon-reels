{
  "$comment": "Brand tokens for the Remotion studio. Source of truth for colors, type, motion and layout. Human-readable rationale: docs/08-gorsel-dil.md",
  "version": 1,
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "color": {
    "night": {
      "950": "#05070C",
      "900": "#0A0E19",
      "800": "#121A2B",
      "700": "#1C2740"
    },
    "gold": {
      "300": "#F3DDA2",
      "400": "#E6C377",
      "500": "#CFA24E",
      "700": "#8A6A2C"
    },
    "ivory": "#F4EFE4",
    "mist": "#A9A6B4",
    "parchment": {
      "200": "#EADBB8",
      "400": "#CDB07A"
    },
    "ink": "#2A1D10",
    "inkSoft": "#6B5232",
    "world": {
      "ocean": { "deep": "#0B2A3C", "light": "#5FB3C9" },
      "desert": { "deep": "#3A2414", "light": "#E29A55" },
      "cosmos": { "deep": "#141B3D", "light": "#8FA8FF" },
      "ember": { "deep": "#3B120C", "light": "#E2603A" },
      "verdant": { "deep": "#0F2A22", "light": "#4FB08A" }
    },
    "forbidden": ["#000000", "#FFFFFF"]
  },
  "font": {
    "display": { "family": "Cormorant Garamond", "weights": [500, 600, 700], "license": "OFL" },
    "body": { "family": "Inter", "weights": [500, 600, 700], "license": "OFL" },
    "data": { "family": "IBM Plex Mono", "weights": [500], "license": "OFL" },
    "quran": { "family": "Amiri Quran", "weights": [400], "license": "OFL", "lineHeight": 1.9 },
    "quranFallback": { "family": "KFGQPC Uthman Taha Naskh", "weights": [400], "license": "verify-before-use" },
    "arabicUi": { "family": "Noto Naskh Arabic", "weights": [400, 600], "license": "OFL" },
    "arabicDecor": { "family": "Reem Kufi", "weights": [500, 700], "license": "OFL", "neverForVerses": true }
  },
  "typeScale": {
    "heroWord": { "min": 160, "max": 220 },
    "headline": 96,
    "subhead": 64,
    "supporting": 48,
    "caption": 50,
    "data": { "min": 72, "max": 200 },
    "sourceLine": 26,
    "verseArabic": { "min": 80, "max": 104 },
    "verseTranslation": 50,
    "minimums": { "headline": 84, "supporting": 44 },
    "fromEpisode004": {
      "$comment": "Episodes 001-003 keep the values above (published). From 004: larger captions, floors for small text and symbols. Lines still fit the 720 px text column.",
      "caption": 60,
      "captionMaxLines": 2,
      "minText": 26,
      "minSymbol": 32,
      "minStroke": 3
    }
  },
  "motion": {
    "easing": {
      "glide": { "type": "bezier", "value": [0.16, 1, 0.3, 1] },
      "settle": { "type": "spring", "damping": 200 },
      "snap": { "type": "bezier", "value": [0.7, 0, 0.84, 0] },
      "camera": { "type": "bezier", "value": [0.65, 0, 0.35, 1] },
      "breathe": { "type": "sine", "periodSeconds": [3, 6] }
    },
    "durationFrames": {
      "micro": 6,
      "short": 12,
      "base": 18,
      "transition": { "min": 10, "max": 24 },
      "reveal": { "min": 30, "max": 60 },
      "verse": { "min": 36, "max": 60 },
      "wordStagger": { "min": 2, "max": 3 }
    },
    "camera": {
      "pushPerScene": { "min": 1.02, "max": 1.06 },
      "driftPx": { "min": 6, "max": 14 }
    },
    "cadenceSeconds": {
      "visualChange": [2, 4],
      "sceneChange": [8, 15],
      "actChange": [20, 45],
      "maxStatic": 4
    }
  },
  "sync": {
    "visualLeadFrames": { "min": 2, "max": 3 },
    "sfxImpactOffsetFrames": -1,
    "riserEndsAtCue": true
  },
  "layout": {
    "safe": {
      "critical": { "x": [90, 900], "y": [220, 1480] },
      "focus": { "x": [90, 900], "y": [300, 1150] },
      "captionBand": { "y": [1220, 1440] },
      "textColumn": {
        "x": [180, 900],
        "$comment": "Every critical text line (verse, translation, source line, caption) is at most 720 px wide and centred on x 540, so it clears the right-side buttons (Shorts ~192 px) without breaking the centred composition. Checked with studio/scripts/safe-zone-scan.js."
      }
    },
    "platformUi": {
      "top": 220,
      "bottom": 440,
      "left": 90,
      "right": 180,
      "$comment": "Approximate union of TikTok, Reels and Shorts overlays. Verify with SafeZoneOverlay in Studio."
    }
  },
  "finish": {
    "grainOpacity": [0.05, 0.07],
    "vignette": [0.25, 0.4],
    "farLayerBlurPx": [2, 6],
    "dustCount": [40, 120]
  },
  "audio": {
    "masterLufs": -14,
    "truePeakDbtp": -1,
    "voicePreMasterLufs": -16,
    "ambienceBelowVoiceDb": [18, 22],
    "duckingDb": [4, 6],
    "revealSilenceSeconds": [0.3, 0.8]
  },
  "render": {
    "codec": "h264",
    "crfFinal": 16,
    "crfDraft": 23,
    "pixelFormat": "yuv420p",
    "audioBitrateFinal": "320k",
    "concurrency": 2,
    "draftScale": 0.5
  }
}
